{
  "name": "@kinglet/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Kinglet — preview your site on every screen",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "start": "install-electron && electron-vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "selftest": "install-electron && electron-vite build && node scripts/selftest.mjs",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@kinglet/core": "workspace:*",
    "@kinglet/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "axe-core": "4.10.3",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "gifenc": "1.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "author": "Steven Persia",
  "homepage": "https://github.com/stevenpersia/kinglet",
  "desktopName": "kinglet.desktop",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-pty": "1.0.0"
  }
}
