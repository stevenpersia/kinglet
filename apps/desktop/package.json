{
  "name": "@parakeet/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Parakeet \u2014 preview your site on every screen",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "start": "install-electron && electron-vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "selftest": "install-electron && electron-vite build && node scripts/selftest.mjs",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@parakeet/core": "workspace:*",
    "@parakeet/mcp": "workspace:*",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "author": "Steven Persia",
  "homepage": "https://github.com/stevenpersia/parakeet",
  "desktopName": "parakeet.desktop",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
