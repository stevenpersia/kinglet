#!/usr/bin/env node
// Stand-in for Claude Code in tests: answers `--version`, and run interactively (in Kinglet's
// terminal) reports what it was started with, then what it receives: pastes and typed lines.
const { readFileSync } = require('node:fs');
const args = process.argv.slice(2);
if (args.includes('--version')) {
  console.log('9.9.9 (Claude Code)');
  process.exit(0);
}
const say = (s) => process.stdout.write(`${s}\r\n`);
let mcp = 'none';
try {
  const file = args[args.indexOf('--mcp-config') + 1];
  if (JSON.parse(readFileSync(file, 'utf8')).mcpServers?.kinglet) mcp = 'kinglet';
} catch {}
if (process.stdin.isTTY) process.stdin.setRawMode(true);
say(`FAKE-CLAUDE ready · tty ${!!process.stdout.isTTY} · mcp ${mcp} · cwd ${process.cwd()}`);
process.stdout.write('> ');

const START = '\x1b[200~';
const END = '\x1b[201~';
let buf = '';
let line = '';
process.stdin.on('data', (chunk) => {
  buf += chunk.toString('utf8');
  for (;;) {
    const s = buf.indexOf(START);
    if (s === 0) {
      const e = buf.indexOf(END);
      if (e < 0) return; // the rest of the paste is coming
      const text = buf.slice(START.length, e);
      buf = buf.slice(e + END.length);
      const image = /\/kinglet-captures\/[^\s]+\.(png|jpe?g|webp)/.test(text);
      say(`PASTED · image ${image ? 'yes' : 'no'} · pointed ${/Element: /.test(text) ? 'yes' : 'no'} · ${text.split('\n')[0].slice(0, 60)}`);
      continue;
    }
    if (!buf) return;
    const upto = s > 0 ? s : buf.length;
    for (const ch of buf.slice(0, upto)) {
      if (ch === '\r' || ch === '\n') {
        say(`TYPED ${line}`);
        line = '';
      } else if (ch === '\x03') process.exit(0);
      else line += ch;
    }
    buf = buf.slice(upto);
  }
});
